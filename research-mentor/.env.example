# ═══════════════════════════════════════════════════════════
# RESEARCH MENTOR — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to GitHub.

# ── Claude API ───────────────────────────────────────────
# Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Access code (recommended) ────────────────────────────
# If set, students must enter this code before requesting
# feedback. Share it with your class or cohort so strangers
# can't run up your API bill. Leave empty for open access.
ACCESS_CODE=
